{
  "name": "sinyallab-futures",
  "version": "1.2.0",
  "private": true,
  "description": "AI-assisted paper futures research for BTCUSDT and ETHUSDT.",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only auth,firestore \"npm run test:emulator:run\"",
    "test:emulator:run": "vitest run tests/emulator",
    "test:e2e": "playwright test",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "auth:readiness": "tsx scripts/auth-readiness.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "migrate:v2": "tsx scripts/migrate-v2.ts",
    "replay": "tsx scripts/replay.ts",
    "evaluation:import": "tsx scripts/import-evaluation.ts",
    "smoke:market": "tsx scripts/live-smoke-test.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "firebase-admin": "13.6.0",
    "next": "16.3.4",
    "openai": "6.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "firebase": "^11.10.0",
    "firebase-tools": "15.30.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
